{
  "_pool": "glm",
  "_target": "__HOME__/.claude-glm/settings.json",
  "_layers": ["common.json", "third-party-common.json"],
  "_comment": "model 字段故意不声明——它是 /model 命令持久化的运行时状态,ccp-sync 会从落盘读回保留。",
  "env": {
    "ANTHROPIC_BASE_URL": "https://open.bigmodel.cn/api/anthropic",
    "ANTHROPIC_MODEL": "glm-5.3-flash[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.2[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "glm-5.3-flash[1m]",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "API_TIMEOUT_MS": "600000",
    "DISABLE_COST_WARNINGS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "availableModels": [
    "opus",
    "sonnet",
    "haiku",
    "glm-5.3[1m]",
    "glm-5.2[1m]",
    "glm-5.1[1m]",
    "glm-5.3-flash[1m]"
  ],
  "modelPicker": {
    "options": [
      {
        "model": "glm-5.3[1m]",
        "label": "GLM 5.3",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "glm-5.3-flash[1m]",
        "label": "GLM 5.3 Flash",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "glm-5.2[1m]",
        "label": "GLM 5.2",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "glm-5.1[1m]",
        "label": "GLM 5.1",
        "behavesAs": "claude-sonnet-5-5"
      }
    ],
    "replaceBuiltInOptions": true
  }
}
