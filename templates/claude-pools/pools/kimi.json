{
  "_pool": "kimi",
  "_target": "__HOME__/.claude-kimi/settings.json",
  "_layers": ["common.json", "third-party-common.json"],
  "_comment": "k3-256k 行无 behavesAs(坑 17 修复形态)+ MAX_CONTEXT_TOKENS=256000 + MODEL_CAPABILITIES 声明(坑 18)。model 字段故意不声明。",
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding",
    "ANTHROPIC_MODEL": "k3.1-pro[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "k3.1-pro[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "k3.1-pro[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "k3.1-pro[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "k3.1-pro[1m]",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "API_TIMEOUT_MS": "600000",
    "DISABLE_COST_WARNINGS": "1",
    "ENABLE_TOOL_SEARCH": "FALSE",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "256000",
    "CLAUDE_CODE_MODEL_CAPABILITIES": "k3-256k=effort,max_effort"
  },
  "availableModels": [
    "opus",
    "sonnet",
    "haiku",
    "k3.1-pro[1m]",
    "k3.1-pro-highspeed[1m]",
    "k3[1m]",
    "k3-256k"
  ],
  "modelPicker": {
    "options": [
      {
        "model": "k3.1-pro[1m]",
        "label": "Kimi K3.1 Pro 1M",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "k3.1-pro-highspeed[1m]",
        "label": "Kimi K3.1 Pro HS 1M",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "k3[1m]",
        "label": "Kimi K3 1M",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "k3-256k",
        "label": "Kimi K3 256K"
      }
    ],
    "replaceBuiltInOptions": true
  },
  "modelSettings": {
    "k3.1-pro-highspeed": {
      "effortLevel": "xhigh"
    },
    "k3.1-pro": {
      "effortLevel": "high"
    }
  }
}
